# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.

# Gmail (envio real): precisa de verificação em duas etapas + Senha de App
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sua-conta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
CONTACT_EMAIL=email-que-recebe@dominio.com
ALLOWED_ORIGIN=https://seu-site.netlify.app

# Ethereal (e-mail falso para testar): gere a conta em https://ethereal.email
# SMTP_HOST=smtp.ethereal.email
# SMTP_USER=<usuario gerado>
# SMTP_PASS=<senha gerada>
# ALLOWED_ORIGIN=
